{
  "name": "@freeagentstore/unit-converter",
  "version": "1.0.0",
  "description": "Convert between units instantly — length, weight, temperature, volume, speed, data, time. No model, no download.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["freeagentstore", "ai", "browser", "heuristic"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreeAgentStore/unit-converter.git"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
